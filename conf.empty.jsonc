/**
Copy this file to ./conf.jsonc
*/

{
  // Port for the local backend server
  "http_port": 5001,
  //port for the local backend websocket server
  "ws_port": 5002,
  "saxo": {
    "start_date": "YYY-MM-DD",
    // Live SAXO app details
    // Must be set up before proceeding
    // https://www.developer.saxo/openapi/learn/direct-clients-request-for-openapi-application-credentials-for-the-live-environ
    "app_key": "",
    "app_secret": "",
    // Set the allowed redirect url in SAXO
    "redirect": "saxo/code",
  },
  "ibkr": {
    "start_date": "YYY-MM-DD",
    // The url of the IBKR client gateway running locally.
    // This is automatically installed at first run in the ./clientportal.. directory
    // https://www.interactivebrokers.com/campus/ibkr-api-page/cpapi-v1/#cpgw
    "base": "https://localhost:5000",
  },
}
